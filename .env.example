# ═══════════════════════════════════════════════════════════
# CITY CONSTRUCTIONS ERP — Server Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development

# MongoDB Atlas — REQUIRED for persistent data
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secrets — CHANGE THESE IN PRODUCTION
JWT_SECRET=change_this_to_a_long_random_string
JWT_REFRESH_SECRET=change_this_to_another_long_random_string

# Client URL (used for CORS configuration)
CLIENT_URL=http://localhost:5173

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Construction ERP <noreply@constructionerp.com>

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key

# File upload max size (in bytes, default 10MB)
MAX_FILE_SIZE=10485760
