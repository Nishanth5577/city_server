PORT=5000
NODE_ENV=development

# MongoDB (leave empty for in-memory dev server)
MONGO_URI=

# JWT
JWT_SECRET=construction_erp_jwt_secret_key_2024_change_in_production
JWT_REFRESH_SECRET=construction_erp_refresh_secret_key_2024_change_in_production

# Client URL
CLIENT_URL=http://localhost:5173

# Email (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Construction ERP <noreply@constructionerp.com>

# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweathermap_api_key

# File upload max size (in bytes)
MAX_FILE_SIZE=10485760
